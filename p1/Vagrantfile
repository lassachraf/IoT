Vagrant.configure("2") do |config|
    # Base Box: Debian 12 (Bookworm)
    config.vm.box = "debian/bookworm64"
  
    # ==========================================
    # 1. Server Node (Control Plane)
    # ==========================================
    config.vm.define "alassiquS" do |server|
      server.vm.hostname = "alassiquS"
      server.vm.network "private_network", ip: "192.168.56.110"
  
      server.vm.provider "virtualbox" do |v|
        v.name = "alassiquS"
        v.cpus = 1
        v.memory = 1024
      end
  
      # Install K3s in Controller/Server mode
      server.vm.provision "shell", path: "scripts/server_script.sh"
    end
  
    # ==========================================
    # 2. Worker Node (Agent)
    # ==========================================
    config.vm.define "alassiquSW" do |worker|
        worker.vm.hostname = "alassiquSW"
        worker.vm.network "private_network", ip: "192.168.56.111"
  
        worker.vm.provider "virtualbox" do |v|
            v.name = "alassiquSW"
            v.cpus = 1
            v.memory = 512
        end
  
        # Install K3s in Agent mode and join the Server
        worker.vm.provision "shell", path: "scripts/worker_script.sh"
    end
end